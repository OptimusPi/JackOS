# Gemini API Key (default in AI Studio preview)
GEMINI_API_KEY=

# Vertex AI (Google Cloud Credits — takes priority when configured)
# Option 1: Standard Vertex AI with Application Default Credentials (GCP / Cloud Run)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Option 2: Vertex AI Express Mode API Key
VERTEX_AI_API_KEY=

# Optional model overrides
VERTEX_TEXT_MODEL=gemini-4-hydrogen
VERTEX_IMAGE_MODEL=gemini-3.1-flash-lite-image
